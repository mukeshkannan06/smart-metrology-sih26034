# ==============================================================================
# SMART METROLOGY — SIH26034 BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to Git.
# Use this template to configure your local backend/.env or Render Web Service.

# --- SERVER ENVIRONMENT ---
# Options: 'development' | 'production' | 'test'
NODE_ENV=development

# Port to listen on (Render sets process.env.PORT automatically)
PORT=5000

# Allowed Frontend URL(s) for CORS & Secure Cookies
# In development: http://localhost:5173
# In production on Render: Set to your deployed Vercel URL (e.g., https://smart-metrology.vercel.app)
# Comma-separated list supported for multiple origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- DATABASE CONNECTION (MongoDB Atlas M0) ---
# Format: mongodb+srv://<username>:<password>@<cluster-url>/smart_metrology?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_address>.mongodb.net/smart_metrology?retryWrites=true&w=majority

# --- AUTHENTICATION & JWT SECURITY ---
# Replace with a cryptographically strong 256-bit random string in production
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h

# --- GOOGLE GEMINI MULTIMODAL AI/OCR (SERVER-SIDE ONLY) ---
# Acquire from Google AI Studio: https://aistudio.google.com/
# NEVER share or expose this key to client-side bundles or frontend
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

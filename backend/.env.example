# Smart Metrology Backend Environment Configuration
# Phase 10: Multimodal AI & Package Declaration Extraction

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection (Phase 4)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart_metrology?retryWrites=true&w=majority

# Authentication Security (Phase 5)
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h

# Google Gemini Multimodal AI (Phase 10)
# Set your Google AI Studio API Key here (Server-side ONLY; never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Smart Metrology Backend Environment Configuration
# Phase 5: Authentication & Role-Based Authorization

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection (Phase 4)
# Free-tier M0 MongoDB Atlas connection string (or local MongoDB URI)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/smart_metrology?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart_metrology?retryWrites=true&w=majority

# Authentication Security (Phase 5)
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h

# Future Phase Placeholders (Do NOT populate with production secrets)
# GEMINI_API_KEY=
# GEMINI_MODEL=


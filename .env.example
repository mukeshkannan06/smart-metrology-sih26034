# ==============================================================================
# SMART METROLOGY — SIH26034 ROOT ENVIRONMENT CONFIGURATION REFERENCE
# ==============================================================================
# This template outlines all environment variables required across both services:
# 1. Frontend (Vercel)
# 2. Backend (Render)

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Configured in Vercel Project Environment Variables)
# ------------------------------------------------------------------------------
# Set this to your live Render backend API URL in Vercel:
VITE_API_BASE_URL=https://smart-metrology-api.onrender.com

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Configured in Render Web Service Environment Variables)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# Set this to your live Vercel frontend URL in Render for CORS & secure cookies:
FRONTEND_URL=https://smart-metrology.vercel.app
CORS_ORIGIN=https://smart-metrology.vercel.app

# MongoDB Atlas M0 Cluster connection string (Backend-only, never exposed):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart_metrology?retryWrites=true&w=majority

# Strong cryptographic secret for JWT sessions (Backend-only, never exposed):
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h

# Google Gemini API Key from Google AI Studio (Backend-only, never exposed):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

